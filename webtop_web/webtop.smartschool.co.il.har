-color: var(--white-100);\n    --card-secodary-title-border-color: var(--primary-500);\n    --card-secodary-title-color: var(--primary-500);\n    --card-text-color: var(--black-87);\n    --card-title-text-color: var(--black-87);\n    --card-border-radius: 4px;\n    --card-box-shadoew-elevation: 0 2px 2px 0 rgba(0, 0, 0, 0.14), 0 3px 1px -2px rgba(0, 0, 0, 0.12), 0 1px 5px 0 rgba(0, 0, 0, 0.2);\n    --card-surface-1-background-color: var(--gray-100);\n    --card-surface-2-background-color: var(--gray-200);\n    --card-surface-3-background-color: var(--gray-300);\n    /*=========dialogs============*/\n    /*dialog-confirm*/\n    --confirm-dialog-container-background-color: var(--white-100);\n    --confirm-dialog-container-text-color: var(--black-87);\n    --confirm-dialog-dialog-header-background-color: var(--white-100);\n    --confirm-dialog-dialog-header-title-color: var(--black-87);\n    --confirm-dialog-footer-border-color: var(--divider-color);\n    --confirm-dialog-header-border-color: var(--divider-color);\n    --confirm-dialog-overlay-backdrop-color: var(--black-38);\n    /*dialog-detailes*/\n    --detailes-dialog-container-background-color: var(--white-100);\n    --detailes-dialog-container-text-color: var(--black-87);\n    --detailes-dialog-footer-border-color: var(--divider-color);\n    --detailes-dialog-header-background-color: var(--primary-500);\n    --detailes-dialog-header-title-color: var(--white-100);\n    --detailes-dialog-overlay-backdrop-color: var(--black-38);\n    /*dialog-form*/\n    --form-dialog-container-background-color: var(--white-100);\n    --form-dialog-container-text-color: var(--black-87);\n    --form-dialog-footer-border-color: var(--divider-color);\n    --form-dialog-header-background-color: var(--primary-500);\n    --form-dialog-header-title-color: var(--white-100);\n    --form-dialog-overlay-backdrop-color: var(--black-38);\n    /*==============================*/\n    /*drawer*/\n    --drawer-container-background-color: var(--whit