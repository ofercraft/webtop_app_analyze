            "size": 9531,
            "mimeType": "text/html",
            "text": "<!DOCTYPE html>\r\n<html lang=\"he\" id=\"htmlMain\" data-beasties-container>\r\n\r\n<head>\r\n  <meta charset=\"utf-8\">\r\n  <title>WebTop</title>\r\n  <base href=\"/\">\r\n  <meta id=\"viewport\" name=\"viewport\" content=\"width=device-width,initial-scale=1.0,maximum-scale=1.0,minimum-scale=1.0,user-scalable=no,shrink-to-fit=no,height=device-height,viewport-fit=contain, target-densitydpi=device-dpi\">\r\n  <meta name=\"format-detection\" content=\"telephone=no\">\r\n  <meta name=\"format-detection\" content=\"address=no\">\r\n  <meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\r\n  <meta name=\"apple-mobile-web-app-title\" content=\"Webtop\">\r\n  <meta name=\"apple-mobile-web-app-status-bar-style\" content=\"default\">\r\n\r\n\r\n  <meta name=\"theme-color\" content=\"var(--app-header-background-color)\">\r\n  <meta name=\"description\" content=\"גרסת ניידת ל-Webtop מבית סמארט סקול מציעה את כל הכלים של שולחן העבודה האינטרנטי ישירות במכשיר הנייד שלכם!\">\r\n\r\n  <link rel=\"icon\" type=\"image/x-icon\" href=\"favicon.ico\">\r\n  <script>\r\n    document.addEventListener('DOMContentLoaded', function() {\r\n      document.body.style.zoom = \"100%\";\r\n    });\r\n\r\n    var myArray = {\r\n      he: \"גרסת ניידת ל-Webtop מבית סמארט סקול מציעה את כל הכלים של שולחן העבודה האינטרנטי ישירות במכשיר הנייד שלכם!\",\r\n      ar: \"توفر نسخة محمولة من Webtop من Smart School جميع أدوات سطح مكتب الويب مباشرة على جهازك المحمول!\",\r\n      en: \"A mobile version of Webtop from Smart School offers all the tools of the web desktop directly on your mobile device!\",\r\n      ru: \"Мобильная версия Webtop от Smart School предлагает все инструменты веб-десктопа прямо на вашем мобильном устройстве!\"\r\n    };\r\n    function getLanguage() {\r\n      var lang = localStorage.getItem('language');\r\n\r\n      document.getElementsByTagName('meta')[\"description\"].content = lang;\r\n      if (lang === undefined || lang === null || lang !== 'en') {\r\n        document.getElementById(\"htmlMain\").dir = \"rtl\";\r\n        document.getElementById(\"mainBody\").dir = \"rtl\";\r\n      } else {\r\n        document.getElementById(\"htmlMain\").dir = \"ltr\";\r\n        document.getElementById(\"mainBody\").dir = \"ltr\";\r\n      }\r\n    }\r\n  </script>\r\n  <!-- <link href=\"https://assets.calendly.com/assets/external/widget.css\" rel=\"stylesheet\">\r\n  <script src=\"https://assets.calendly.com/assets/external/widget.js\" type=\"text/javascript\" async></script> -->\r\n  <script src=\"./assets/tinymce/js/tinymce/tinymce.min.js\" type=\"text/javascript\" async></script>\r\n<style>.mat-typography{font:400 14px/20px Roboto, \"Helvetica Neue\", sans-serif;letter-spacing:normal}body,html{line-height:1.5}img{vertical-align:middle}body{text-align:left}.col{max-width:100%}*,::after,::before{box-sizing:border-box}html{font-family:sans-serif;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%;-ms-overflow-style:scrollbar;-webkit-tap-highlight-color:transparent}body{margin:0;font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,\"Helvetica Neue\",Arial,sans-serif,\"Apple Color Emoji\",\"Segoe UI Emoji\",\"Segoe UI Symbol\",\"Noto Color Emoji\";font-size:1rem;font-weight:400;color:#212529;background-color:#fff}img{border-style:none}.h-100{height:100%!important}.w-100{width:100%!important}.row{display:flex;flex-wrap:wrap;margin-right:-15px;margin-left:-15px}.col{flex-basis:0;flex-grow:1}.centerCenter{place-content:center;align-items:center;flex-direction:row !important;box-sizing:border-box;display:flex !important}:root{--primary-25:#f0f5fa;--primary-50:#e9edf2;--primary-100:#b9c4cf;--primary-200:#97a7b7;--primary-300:#687f96;--primary-400:#2e5276;--primary-500:#1d4063;--primary-600:#1a3a5a;--primary-700:#152d46;--primary-800:#102336;--primary-900:#0c1b2a;--primary-06:#0068de0f;--primary-12:#0068de1f;--secondary-25:#f4fbfa;--secondary-50:#def2f0;--secondary-100:#bce3e0;--secondary-200:#9bd6d1;--secondary-300:#6