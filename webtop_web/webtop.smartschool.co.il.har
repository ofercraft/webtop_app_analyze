gle-disabled-text-color: var(--black-20);\n    --button-toggle-focus-color: var(--primary-12);\n    --button-toggle-hover-state-color: var(--primary-06);\n    --button-toggle-pressed-color: var(--primary-12);\n    --button-toggle-selected-background-color: var(--primary-25);\n    --button-toggle-selected-border-color: var(--primary-500);\n    --button-toggle-selected-icon-color: var(--primary-500);\n    --button-toggle-selected-text-color: var(--primary-500);\n    --button-toggle-unselected-background-color: var(--white-100);\n    --button-toggle-unselected-border-color: var(--natural-300);\n    --button-toggle-unselected-icon-color: var(--natural-600);\n    --button-toggle-unselected-text-color: var(--natural-600);\n    /*================BUTTONS==============*/\n    /*filled-button-primary-color*/\n    --button-filled-background-color: var(--primary-500);\n    --button-filled-disabled-background-color: var(--black-12);\n    --button-filled-disabled-text-color: var(--black-38);\n    --button-filled-focus-state-color: var(--primary-600);\n    --button-filled-hover-state-color: var(--primary-400);\n    --button-filled-pressed-state-color: var(--primary-600);\n    --button-filled-text-color: var(--white-100);\n    /*button-outline-primary-color*/\n    --button-outline-border-color: var(--primary-500);\n    --button-outline-disabled-border-color: var(--black-38);\n    --button-outline-disabled-text-color: var(--black-38);\n    --button-outline-focus-state-color: var(--primary-12);\n    --button-outline-hover-state-color: var(--primary-06);\n    --button-outline-pressed-state-color: var(--primary-12);\n    --button-outline-text-color: var(--primary-500);\n    /*text-button*/\n    --button-text-background-color: var(--wt-transparent);\n    --button-text-disabled-background-color: var(--wt-transparent);\n    --button-text-disabled-text-color: var(--black-38);\n    --button-text-focus-state-color: var(--primary-12);\n    --button-text-hover-state-color: var(--primary-06);\n